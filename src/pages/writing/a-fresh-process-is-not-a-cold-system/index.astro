        <a class="inline-link" href={`${evidenceBase}/post-reboot-summary.json`}>
          Post-reboot evidence
        </a>
        <a class="inline-link" href="/writing/">All writing</a>
      </div>
    </section>
  </article>
</BaseLayout>
